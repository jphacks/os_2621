# ==========================================
# ChatTomo 環境設定リファレンス
# ==========================================

# ------------------------------------------
# 1. Supabase 設定 (必須)
# ------------------------------------------
# Supabase プロジェクト設定 > API から取得してください
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...
# バックエンドAPI（要約生成・マッチング・安全フィルタ・RLSバイパス処理）用
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# ------------------------------------------
# 2. LLM プロバイダー設定 (Claude または Gemini)
# ------------------------------------------
# 使用するプロバイダー: "anthropic" または "gemini" (未指定時は "anthropic")
LLM_PROVIDER=gemini

# [Anthropic Claude を使用する場合]
# ANTHROPIC_API_KEY=sk-ant-api03-...
# モデル指定（省略可: main=claude-3-5-sonnet-20241022 / fast=claude-3-5-haiku-20241022）
# ANTHROPIC_MODEL_MAIN=claude-3-5-sonnet-20241022
# ANTHROPIC_MODEL_FAST=claude-3-5-haiku-20241022

# [Google Gemini を使用する場合 (ハッカソン推奨・無料枠対応)]
# Google AI Studio (https://aistudio.google.com/apikey) でキーを取得
GEMINI_API_KEY=AIzaSy...
# モデル指定（省略可: main=gemini-2.5-flash / fast=gemini-2.5-flash-lite）
GEMINI_MODEL_MAIN=gemini-2.5-flash
GEMINI_MODEL_FAST=gemini-2.5-flash-lite

# ------------------------------------------
# 3. 開発・デモ用フラグ (任意)
# ------------------------------------------
# デモ・審査用: "true" に設定するとルームタイマーを30分から短縮モードへ変更
NEXT_PUBLIC_DEMO_FAST_TIMER=false

# 開発用画面遷移バー（P0〜P9）: "true" のときのみヘッダーにリンクバーを表示
# 本番運用時は false または未設定にして、正規のフロー制御（FlowGuard）に統一します
NEXT_PUBLIC_DEV_NAV=false

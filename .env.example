NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL_MAIN=
ANTHROPIC_MODEL_FAST=

# デモ用: true のとき、ルームの時間などを短くする
NEXT_PUBLIC_DEMO_FAST_TIMER=

# 無料のGeminiを使うとき: LLM_PROVIDER=gemini にして、GEMINI_API_KEY を設定する（Claudeのキーは不要）
# キーは https://aistudio.google.com/apikey で作れる。モデルは空なら既定値（main=gemini-3.8-flash / fast=gemini-3.5-flash-lite）
LLM_PROVIDER=
GEMINI_API_KEY=
GEMINI_MODEL_MAIN=
GEMINI_MODEL_FAST=
